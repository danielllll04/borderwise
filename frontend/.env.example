# Leave empty in dev: Vite proxies /api to http://127.0.0.1:3000 (see vite.config.ts).
# Prefer same-origin /api routing in deployment too. An optional public HTTPS backend
# URL requires deployment CORS configuration; never include credentials/query/fragment.
VITE_API_BASE_URL=
# Live is the default. Explicit true = in-memory mock; manual backend Compare is disabled there.
VITE_USE_MOCK=false
# Optional launching PowerShell setting (server-only; not a browser variable):
# $env:BORDERWISE_DEV_API_TARGET='http://127.0.0.1:3000'
# Never put Groq keys or database URLs in any VITE_* setting.
