{
  "name": "borderwise-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BorderWise Home, plans and read-only Agent backend (local demo; no authentication)",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "predb:migrate": "tsx scripts/prepare-sqlite.ts",
    "db:migrate": "prisma migrate deploy",
    "predb:migrate:dev": "tsx scripts/prepare-sqlite.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "demo:post": "tsx scripts/demo-post.ts",
    "demo:plans": "tsx scripts/demo-plans.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "demo:split": "tsx scripts/demo-shared-expense.ts",
    "receipts:cleanup": "tsx scripts/cleanup-receipts.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "decimal.js": "10.6.0",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.0",
    "eslint": "9.39.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
