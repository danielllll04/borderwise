# Relative SQLite paths resolve from prisma/schema.prisma (prisma/dev.db).
DATABASE_URL="file:./dev.db"
# Keep SQLite available for rollback. Switch only after online import/verification succeeds.
BORDERWISE_DATABASE_PROVIDER="sqlite"
# Server-only Session pooler (5432) or direct PostgreSQL URL; includes a private password.
# Enter only in ignored .env, never frontend/chat. The dedicated schema is borderwise.
SUPABASE_DATABASE_URL=""
HOST="127.0.0.1"
PORT="3000"
LOG_LEVEL="info"

# Default provider. Home and plans work without Groq credentials.
AGENT_PROVIDER="groq"
GROQ_API_KEY=""
# Supply an available Groq model supporting local function/tool calling. No assumed default.
# Successfully verified on 2026-10-19: openai/gpt-oss-120b (see docs/groq-verification.md).
# Example: GROQ_MODEL="openai/gpt-oss-120b"; confirm current availability before use.
GROQ_MODEL=""
# Compare is independent of the model provider. HTTP to seeded Steve data is still Simulated.
COMPARE_PROVIDER="steve"
# Trusted server-only origin. Start FastAPI locally as documented; never accept this from chat.
STEVE_COMPARE_BASE_URL="http://127.0.0.1:8000"
# Per-request bound, 250–10000 ms. POST is never retried; quote GET retries once.
STEVE_COMPARE_TIMEOUT_MS="5000"
# ATM & Alerts reuses this trusted server URL/timeout. Node /api/atms reads the
# existing Compare adapter; /api/alerts/check validates Steve's seeded rate check.
# No browser keys, notification subscription or financial posting are added.
# Explicit static fixtures only: COMPARE_PROVIDER="fixture" (never a failure fallback).
# For explicitly scripted development only: AGENT_PROVIDER="demo"
# Optional demo provider fault: AGENT_DEMO_FAILURE="rate_limit" or "unavailable"

# Receipt HTTP is opt-in. OCR currently receives the image but returns Steve's Simulated sample.
RECEIPT_PROVIDER="steve"
# Optional override; blank reuses STEVE_BASE_URL or STEVE_COMPARE_BASE_URL.
STEVE_RECEIPT_BASE_URL=""
# Bounded below the 8-second receipt orchestration limit: 250–7000 ms.
STEVE_RECEIPT_TIMEOUT_MS="5000"
# Required server-side JSON array of {participant_id, display_name}; placeholders only.
# Include the current demo payer ID demo-profile. Never use display names as identity keys.
RECEIPT_PARTICIPANTS_JSON=""
# Explicit fixtures: RECEIPT_PROVIDER="demo". Disable: RECEIPT_PROVIDER="unavailable".
# Optional server-only storage override. Default: .local/receipts (private, Git ignored).
# RECEIPT_STORAGE_DIR=""
